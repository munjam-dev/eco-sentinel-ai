# EcoSentinel AI Environment Configuration

PROJECT_NAME="EcoSentinel AI Backend"
API_V1_STR="/api/v1"
SECRET_KEY="production_super_secret_jwt_key_change_me_in_prod"
ENVIRONMENT="development"
DEBUG=true

# Database (PostgreSQL / Supabase)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/ecosentinel_db"
SYNC_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecosentinel_db"

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "https://ecosentinel-app.vercel.app"]

# Telemetry & Thresholds
DEFAULT_DATA_RETENTION_DAYS=90
EMERGENCY_ALERT_WEBHOOK=""

# LoRa Mesh Concentrator Security Token
LORA_GATEWAY_SECRET="lora_gateway_auth_token_998877"
